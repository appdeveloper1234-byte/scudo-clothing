# Firebase client configuration (safe to expose to the browser; restrict the key in Google Cloud)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (Netlify Functions only; never prefix these with VITE_)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative: provide the complete service-account JSON instead of the three fields above
FIREBASE_ADMIN_SERVICE_ACCOUNT=
ADMIN_EMAILS=scudoclothing@gmail.com

# Razorpay server configuration (Netlify Functions only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ALLOWED_ORIGIN=https://zeroxclothing.netlify.app
